---
/** A landing-page section: an eyebrow in the label face, a heading and a lede, then the slot. */
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---

<section class="kd-section not-content" id={id}>
  <header>
    {eyebrow && <span class="kd-eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {Astro.slots.has('lede') && <p><slot name="lede" /></p>}
  </header>
  <slot />
</section>
