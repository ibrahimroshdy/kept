---
import { withBase } from './base';
/**
 * A grid of the kit's cards (surface, hairline, 10px corners), each with an icon tile. A card
 * with `href` is a link to that page.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Item {
  icon: IconName;
  title: string;
  body: string;
  href?: string;
}
interface Props {
  items: Item[];
  columns?: 2 | 3;
}
const { items, columns = 3 } = Astro.props;
---

<ul class:list={['kd-cards', `kd-cards-${columns}`]}>
  {
    items.map(({ icon, title, body, href }) => {
      const Tag = href ? 'a' : 'div';
      return (
        <li>
          <Tag class:list={['kd-card', { 'kd-card-link': href }]} href={href ? withBase(href) : undefined}>
            <span class="kd-card-icon">
              <Icon name={icon} />
            </span>
            <span class="kd-card-title">{title}</span>
            <span class="kd-card-body">{body}</span>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .kd-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.875rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .kd-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .kd-cards-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .kd-cards li {
    margin: 0;
    display: grid;
  }
  .kd-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    align-items: start;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .kd-card-link {
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .kd-card-link:hover {
    border-color: var(--ink-3);
  }
  .kd-card-link:hover .kd-card-title {
    color: var(--amber-text);
  }
  .kd-card-icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 8px;
    background: var(--sunken);
    color: var(--ink-2);
  }
  .kd-card-title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .kd-card-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
