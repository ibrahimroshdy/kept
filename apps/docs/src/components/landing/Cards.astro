---
import { withBase } from './base';
/**
 * A grid of the kit's cards (surface, hairline, 10px corners), each with an icon tile. A card
 * with `href` is a link to that page. With `heading`, each card's title is that heading (h3 or
 * h4), so a section of features reads as headings to a screen reader and a search engine.
 *
 * `compact` is the landing page's tile: the icon beside the title, one fragment under both, and
 * two to a row from the narrowest phone, so six tiles take three short rows instead of six tall
 * ones. `columns` is how many to a row on a wide screen.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Item {
  icon: IconName;
  title: string;
  body: string;
  href?: string;
}
interface Props {
  items: Item[];
  columns?: 2 | 3 | 4;
  heading?: 'h3' | 'h4';
  compact?: boolean;
}
const { items, columns = 3, heading, compact = false } = Astro.props;
const Title = heading ?? 'span';
---

<ul class:list={['kd-cards', `kd-cards-${columns}`, { 'kd-cards-compact': compact }]}>
  {
    items.map(({ icon, title, body, href }) => {
      const Tag = href ? 'a' : 'div';
      return (
        <li>
          <Tag class:list={['kd-card', { 'kd-card-link': href }]} href={href ? withBase(href) : undefined}>
            <span class="kd-card-icon">
              <Icon name={icon} size={compact ? 18 : 22} />
            </span>
            <Title class="kd-card-title">{title}</Title>
            <span class="kd-card-body">{body}</span>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .kd-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.875rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .kd-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .kd-cards-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .kd-cards-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .kd-cards li {
    margin: 0;
    display: grid;
  }
  .kd-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    align-items: start;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .kd-card-link {
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .kd-card-link:hover {
    border-color: var(--ink-3);
  }
  .kd-card-link:hover .kd-card-title {
    color: var(--amber-text);
  }
  .kd-card-icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 8px;
    background: var(--sunken);
    color: var(--ink-2);
  }
  .kd-card-title {
    display: block;
    margin: 0;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .kd-card-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Compact: two to a row on a phone, the icon beside the title, the fragment under both. */
  .kd-cards-compact {
    gap: 0.625rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .kd-cards-compact .kd-card {
    grid-template-rows: auto 1fr;
    column-gap: 0.5rem;
    row-gap: 0.375rem;
    align-items: center;
    padding: 0.75rem 0.875rem 0.875rem;
  }
  .kd-cards-compact .kd-card-icon {
    grid-row: auto;
    inline-size: 1.875rem;
    block-size: 1.875rem;
    border-radius: 6px;
  }
  .kd-cards-compact .kd-card-title {
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  .kd-cards-compact .kd-card-body {
    grid-column: 1 / -1;
    align-self: start;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  @media (min-width: 50rem) {
    .kd-cards-compact.kd-cards-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .kd-cards-compact.kd-cards-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .kd-cards-compact .kd-card {
      padding: 0.875rem 1rem 1rem;
    }
  }
</style>
