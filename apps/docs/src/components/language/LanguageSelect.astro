---
/**
 * The language menu (a Starlight component override of LanguageSelect). Starlight's own picker is
 * a native <select>, which opens the operating system's menu; Kept never uses a native picker, and
 * a native menu can't show a flag. This is a disclosure instead: a <details> whose <summary> shows
 * the current language and whose panel is a list of plain links, one per locale, each to the same
 * page in that language. Without JavaScript it still opens, closes and navigates (the browser
 * does it all). The script adds what a menu button needs on top: arrow keys between the links,
 * Escape to close and return focus, and closing on a click outside or when focus leaves.
 *
 * The links follow Starlight's routing: the root locale has no prefix, every other locale is the
 * first path segment, after the site's base path. Starlight builds every page in every locale
 * (untranslated ones show the English text under its "not translated yet" notice), so every link
 * exists.
 */
import { locales } from '../../locales.mjs';
import Flag from './Flag.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = Astro.locals.starlightRoute.locale ?? 'root';

/** The current page's path in another locale. */
function pathIn(code: string): string {
  let path = Astro.url.pathname;
  if (base && path.startsWith(`${base}/`)) path = path.slice(base.length);
  const [, first = '', ...rest] = path.split('/');
  const tail = first !== 'root' && first in locales ? rest.join('/') : path.slice(1);
  return `${base}${code === 'root' ? '' : `/${code}`}/${tail}`;
}

const items = Object.entries(locales).map(([code, locale]) => ({
  code,
  label: locale.label,
  lang: locale.lang,
  dir: 'dir' in locale ? locale.dir : 'ltr',
  href: pathIn(code),
  current: code === current,
}));
const now = items.find((item) => item.current) ?? items[0];
const label = Astro.locals.t('languageSelect.accessibleLabel');
---

<kd-lang-menu>
  <details class="kd-lang">
    <summary class="kd-lang-button">
      <span class="sr-only">{label}:</span>
      <Flag code={now.code} />
      <span class="kd-lang-name" lang={now.lang} dir={now.dir}>{now.label}</span>
      <svg class="kd-lang-chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>
    <ul class="kd-lang-list" aria-label={label}>
      {
        items.map((item) => (
          <li>
            <a href={item.href} hreflang={item.lang} aria-current={item.current ? 'true' : undefined}>
              <Flag code={item.code} />
              <span class="kd-lang-name" lang={item.lang} dir={item.dir}>
                {item.label}
              </span>
              {item.current && (
                <svg class="kd-lang-check" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</kd-lang-menu>

<script>
  class KeptLanguageMenu extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector('details');
      const summary = details?.querySelector('summary');
      if (!details || !summary) return;
      const links = () => [...details.querySelectorAll<HTMLAnchorElement>('.kd-lang-list a')];
      const close = (refocus: boolean) => {
        if (!details.open) return;
        details.open = false;
        if (refocus) summary.focus();
      };
      const focusLink = (index: number) => {
        const all = links();
        all[(index + all.length) % all.length]?.focus();
      };

      summary.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          details.open = true;
          const all = links();
          const at = all.findIndex((a) => a.hasAttribute('aria-current'));
          focusLink(event.key === 'ArrowUp' ? all.length - 1 : Math.max(at, 0));
        }
      });
      details.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          event.preventDefault();
          close(true);
          return;
        }
        const all = links();
        const at = all.indexOf(document.activeElement as HTMLAnchorElement);
        if (at === -1) return;
        if (event.key === 'ArrowDown') focusLink(at + 1);
        else if (event.key === 'ArrowUp') focusLink(at - 1);
        else if (event.key === 'Home') focusLink(0);
        else if (event.key === 'End') focusLink(all.length - 1);
        else return;
        event.preventDefault();
      });
      // Opening with the keyboard moves focus to the current language; a click leaves it on the
      // button, as a disclosure does.
      details.addEventListener('toggle', () => {
        if (details.open && summary.matches(':focus-visible')) {
          links()
            .find((a) => a.hasAttribute('aria-current'))
            ?.focus();
        }
      });
      // Tab out of the menu, or click anywhere else, and it closes.
      details.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (next instanceof Node && !details.contains(next)) close(false);
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !details.contains(event.target)) close(false);
      });
      // A page restored from the back/forward cache comes back with the menu as it was left.
      window.addEventListener('pageshow', () => close(false));
    }
  }
  if (!customElements.get('kd-lang-menu')) customElements.define('kd-lang-menu', KeptLanguageMenu);
</script>

<style>
  kd-lang-menu {
    display: block;
    position: relative;
  }
  .kd-lang-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.25rem;
    padding-inline: 0.625rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--ink-2);
    font-size: var(--sl-text-sm);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .kd-lang-button::-webkit-details-marker {
    display: none;
  }
  .kd-lang-button:hover,
  .kd-lang[open] > .kd-lang-button {
    border-color: var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .kd-lang-chevron {
    color: var(--ink-3);
    transition: transform 0.15s ease;
  }
  .kd-lang[open] .kd-lang-chevron {
    transform: rotate(180deg);
  }
  .kd-lang-list {
    position: absolute;
    z-index: 20;
    inset-block-start: calc(100% + 0.375rem);
    inset-inline-end: 0;
    min-inline-size: 11rem;
    margin: 0;
    padding: 0.3125rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--kd-radius, 10px);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 14px 32px -12px rgb(0 0 0 / 0.3);
  }
  /* In the phone menu the picker sits at the bottom of the panel: open upwards. */
  :global(.mobile-preferences) .kd-lang-list {
    inset-block: auto calc(100% + 0.375rem);
  }
  .kd-lang-list li {
    margin: 0;
  }
  .kd-lang-list a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--kd-radius-sm, 6px);
    color: var(--ink);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .kd-lang-list a:hover,
  .kd-lang-list a:focus-visible {
    background: var(--sunken);
  }
  .kd-lang-list a[aria-current] {
    font-weight: 600;
  }
  .kd-lang-check {
    margin-inline-start: auto;
    color: var(--amber-text);
  }
  .kd-lang-name {
    white-space: nowrap;
  }
  .kd-lang :global(.kd-flag) {
    flex: none;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  :global(:root[data-theme="dark"]) .kd-lang :global(.kd-flag) {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }
</style>
