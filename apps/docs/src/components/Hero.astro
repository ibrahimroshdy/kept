---
import { getImage } from 'astro:assets';
/**
 * The landing page's hero (a Starlight component override; only pages with `hero` frontmatter
 * render it). The copy comes from the page's frontmatter as in Starlight's own Hero; the art is
 * the 3D location map (D237) in a browser frame, the page's headline.
 *
 * The captures are src/assets/landing/map-hero-{light,dark}.webp (1600 × 1000, 16:10), the light
 * one under the light theme and the dark one under dark. The Arabic page uses
 * map-hero-ar-{light,dark}.webp when both exist (the app in Arabic); until then it shows the
 * English map, the one place an Arabic page does. Astro serves them as WebP at the widths below.
 *
 * It is the largest paint on the page, so it is one <img>, eager and fetchpriority high, in a
 * <picture> whose dark <source> matches the theme Starlight resolves on first load: dark unless
 * the system says light (`not all and (prefers-color-scheme: light)`). The browser's preload
 * scanner picks the right one before any script runs, and fetches only that one. The inline
 * script after it covers a theme the reader chose in the switcher (and a later switch): it points
 * the <source> at the theme in data-theme, which kept.css reads the same way (dark unless
 * "light"). Only a chosen theme that differs from the system's fetches the other image too.
 * Keep the alt text true to the capture.
 *
 * Under the actions, the facts line: three short facts, one idea each.
 */
import { LinkButton } from '@astrojs/starlight/components';
import type { ImageMetadata } from 'astro';
import { withBase } from './landing/base';

const { entry, lang } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero || {};
const ar = lang === 'ar';

const eyebrow = ar ? 'جديد · الخريطة ثلاثية الأبعاد' : 'New · The 3D map';
const facts = ar
  ? ['AGPL-3.0', 'Docker أو Kubernetes', 'تطبيق هاتف بلا اتصال']
  : ['AGPL-3.0', 'Docker or Kubernetes', 'Offline phone app'];
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/landing/map-hero*.webp', {
  eager: true,
});
const capture = (suffix: string) => files[`../assets/landing/map-hero${suffix}.webp`]?.default;
const arabic = ar && capture('-ar-light') && capture('-ar-dark');
const light = capture(arabic ? '-ar-light' : '-light');
const dark = capture(arabic ? '-ar-dark' : '-dark');
if (!light || !dark) throw new Error('missing src/assets/landing/map-hero-{light,dark}.webp');
const mapAlt = ar
  ? 'خريطة Kept ثلاثية الأبعاد لمنزل: غرفه في منظر مائل، لكلٍّ منها اسمها، بأثاثها وصناديقها، بجانب شجرة أماكن الموقع'
  : "Kept's 3D map of a home: its rooms in an isometric view, each labelled, with furniture and boxes, beside the location's tree of places";
const widths = [480, 720, 960, 1280, 1600];
const sizes = '(min-width: 72rem) 36rem, (min-width: 50rem) 52vw, calc(100vw - 2rem)';
const [lit, dim] = await Promise.all(
  [light, dark].map((src) => getImage({ src, widths, format: 'webp', quality: 80 })),
);
/** Starlight's own first-load rule (ThemeProvider): dark unless the system prefers light. */
const darkMedia = 'not all and (prefers-color-scheme: light)';
---

<div class="kd-hero">
  <div class="kd-hero-copy">
    <span class="kd-hero-tape"><span class="kd-hero-hole" aria-hidden="true"></span>{eyebrow}</span>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="kd-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="kd-hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
            <LinkButton href={withBase(link)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
    <ul class="kd-hero-facts">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>
  <div class="kd-hero-art">
    <div class="kd-frame">
      <div class="kd-frame-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <picture>
        <source
          media={darkMedia}
          srcset={dim.srcSet.attribute}
          sizes={sizes}
          type="image/webp"
          width={dark.width}
          height={dark.height}
        />
        <img
          src={lit.src}
          srcset={lit.srcSet.attribute}
          sizes={sizes}
          alt={mapAlt}
          width={light.width}
          height={light.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <script is:inline data-media={darkMedia}>
        (() => {
          const me = document.currentScript;
          const source = me?.previousElementSibling?.querySelector('source');
          if (!source) return;
          const root = document.documentElement;
          const apply = () => {
            source.media = root.dataset.theme === 'light' ? 'not all' : 'all';
          };
          if ((root.dataset.theme !== 'light') !== matchMedia(me.dataset.media).matches) apply();
          new MutationObserver(apply).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
        })();
      </script>
    </div>
  </div>
</div>

<style>
  .kd-hero {
    display: grid;
    gap: 2rem;
    padding-block: 0.5rem 0;
    align-items: center;
  }
  .kd-hero-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    min-width: 0;
  }
  .kd-hero-tape {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--amber);
    color: var(--amber-ink);
    font: 600 0.75rem / 1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem 0.4375rem;
    border-radius: 3px;
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.12);
  }
  :global(:root:lang(ar)) .kd-hero-tape {
    font-family: var(--arabic);
    letter-spacing: 0;
    text-transform: none;
    font-size: 0.8125rem;
  }
  .kd-hero-hole {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--paper);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  :global(:root:lang(ar)) h1 {
    letter-spacing: 0;
    line-height: 1.25;
  }
  .kd-hero-tagline {
    margin: 0;
    max-inline-size: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .kd-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .kd-hero-actions :global(.sl-link-button) {
    margin: 0;
  }
  .kd-hero-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font: 500 0.8125rem / 1.4 var(--mono);
    color: var(--ink-3);
  }
  :global(:root:lang(ar)) .kd-hero-facts {
    font-family: var(--arabic);
  }
  .kd-hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .kd-hero-facts li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .kd-hero-art {
    min-width: 0;
  }
  .kd-frame {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 40px -18px rgb(0 0 0 / 0.28);
  }
  .kd-frame picture {
    display: block;
  }
  .kd-frame :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .kd-frame-bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    border-block-end: 1px solid var(--line);
    background: var(--sunken);
  }
  .kd-frame-bar i {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: var(--line);
  }
  @media (min-width: 50rem) {
    .kd-hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3rem;
      padding-block: clamp(2.5rem, 1rem + 6vmin, 5rem) 1.5rem;
    }
  }
</style>
