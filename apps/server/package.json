{
  "name": "@kept/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kept": "dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node dist/reports/render/build-assets.js && chmod +x dist/cli/index.js",
    "kept": "tsx src/cli/index.ts",
    "bench": "tsx bench/rls.bench.ts",
    "bench:pi": "NODE_OPTIONS=--max-old-space-size=512 tsx bench/rls.bench.ts --pi",
    "bench:pi-speed": "NODE_OPTIONS=--max-old-space-size=512 taskpolicy -b tsx bench/rls.bench.ts --pi-cpus 0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/google": "4.0.82",
    "@ai-sdk/groq": "4.0.50",
    "@ai-sdk/openai": "4.0.78",
    "@ai-sdk/openai-compatible": "3.0.57",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@better-auth/cimd": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.21.1",
    "@fastify/static": "10.1.4",
    "@fastify/swagger": "9.9.0",
    "@kept/mcp": "workspace:*",
    "@kept/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/core": "11.4.0",
    "@simplewebauthn/server": "13.3.3",
    "ai": "7.0.116",
    "better-auth": "1.7.6",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.1.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "undici": "8.11.2",
    "unpdf": "1.8.1",
    "uqr": "0.1.3",
    "uuid": "14.0.2",
    "web-push": "3.6.7",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
