# The image is built from sources only: dependencies are installed and everything is compiled
# inside the build (Dockerfile). Nothing from the developer's machine rides along.
.git
.githooks
.idea
.vscode
.tmp
**/node_modules
**/dist
# Generated by the server build (the report's fonts, src/reports/render/fonts.ts).
apps/server/assets/fonts
**/coverage
**/test-results
**/playwright-report
**/*.log
**/.DS_Store

# Secrets and local environment: never in a build context.
.env
.env.*
**/*.pem
**/*.key

# Not needed to build or run the image.
docs
compose*.yaml
compose.env.example
Dockerfile
.dockerignore
docker/initdb
docker/initdb-prod
docker/caddy
