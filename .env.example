KEPT_DATABASE_URL=postgres://kept_app:kept_app@localhost:5452/kept
KEPT_AUTH_DATABASE_URL=postgres://kept_auth:kept_auth@localhost:5452/kept
KEPT_SYSTEM_DATABASE_URL=postgres://kept_system:kept_system@localhost:5452/kept
KEPT_OWNER_DATABASE_URL=postgres://kept_owner:kept_owner@localhost:5452/kept
KEPT_PUBLIC_URL=http://localhost:5173
KEPT_ROLE=all
KEPT_LOG_FORMAT=pretty
KEPT_SMTP_URL=smtp://localhost:1025
KEPT_MAX_FILE_MB=25
# KEPT_IMAGE_CONCURRENCY=2
KEPT_STORAGE=local
# S3 (T18) against the dev RustFS on 9452: set KEPT_STORAGE=s3 and these.
# KEPT_S3_ENDPOINT=http://localhost:9452
# KEPT_S3_PUBLIC_ENDPOINT=
# KEPT_S3_REGION=us-east-1
# KEPT_S3_BUCKET=kept
# KEPT_S3_ACCESS_KEY_ID=
# KEPT_S3_SECRET_ACCESS_KEY=
# KEPT_S3_FORCE_PATH_STYLE=true
# Step 3: AI answers from the mock provider (never in production); barcode lookup; the
# extraction evaluation's photo folder (pnpm eval:extraction).
# KEPT_AI_MOCK=1
# KEPT_BARCODE_LOOKUP=false
# KEPT_BARCODE_CONTACT=you@example.org
# KEPT_EVAL_DIR=
# Step 4: web push. Unset, a VAPID pair is generated at first run; set both to bring your own.
# Push needs a subject: an https KEPT_PUBLIC_URL, KEPT_SMTP_FROM, or this.
# KEPT_VAPID_PUBLIC_KEY=
# KEPT_VAPID_PRIVATE_KEY=
# KEPT_VAPID_SUBJECT=mailto:you@example.org
# Step 6: semantic search's embeddings (provider · off; local is refused, D207), and generic OIDC
# sign-in (set the issuer and client id to turn it on).
# KEPT_EMBEDDINGS=provider
# KEPT_EMBEDDINGS_DIR=
# KEPT_OIDC_ISSUER=https://id.example.org/realms/kept
# KEPT_OIDC_CLIENT_ID=
# KEPT_OIDC_CLIENT_SECRET=
# KEPT_OIDC_NAME=OIDC
# KEPT_OIDC_AUTOPROVISION_DOMAINS=
# KEPT_OIDC_AUTOPROVISION_GROUPS=
# KEPT_OIDC_GROUPS_CLAIM=groups
# KEPT_OIDC_SCOPES=openid email profile
